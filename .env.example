# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=
# Notion internal integration token (starts with ntn_ or secret_).
# Create one at https://www.notion.so/my-integrations and share the
# issues database with it. Used by .sandcastle/tracker.sh.
NOTION_TOKEN=
# Bitbucket credentials — used by .sandcastle/bitbucket.sh to push branches
# and open PRs. Create an API token at https://bitbucket.org/account/settings/api-tokens/
BB_EMAIL=
BB_TOKEN=
# Optional: override workspace/repo (defaults derived from `git remote get-url origin`).
# BB_WORKSPACE=
# BB_REPO=
